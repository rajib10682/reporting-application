      <hashTree>
        <!-- Concurrent Queue Operations -->
        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="Concurrent Queue Stress Test" enabled="true">
          <stringProp name="BeanShellSampler.query">
import redis.clients.jedis.Jedis;
import java.util.UUID;

try {
    Jedis jedis = new Jedis("${REDIS_HOST}", Integer.parseInt("${REDIS_PORT}"));
    
    String queueKey = "${QUEUE_KEY}_stress";
    long startTime = System.currentTimeMillis();
    
    // Rapid queue operations
    for (int i = 0; i &lt; 5; i++) {
        String reportId = "stress_report_" + UUID.randomUUID().toString();
        String userId = "stress_user_" + (int)(Math.random() * 50);
        long timestamp = System.currentTimeMillis() + i;
        
        // Add to queue
        jedis.zadd(queueKey, timestamp, reportId + ":" + userId);
        
        // Immediately try to process
        if (Math.random() > 0.5) {
            jedis.zrem(queueKey, reportId + ":" + userId);
        }
    }
    
    // Check queue metrics
    long queueSize = jedis.zcard(queueKey);
    long memoryUsage = jedis.memoryUsage(queueKey);
    
    long endTime = System.currentTimeMillis();
    long duration = endTime - startTime;
    
    jedis.close();
    
    SampleResult.setResponseData("Stress test completed in " + duration + "ms. Final queue size: " + queueSize + ". Memory usage: " + memoryUsage + " bytes");
    SampleResult.setSuccessful(true);
    
} catch (Exception e) {
    SampleResult.setResponseData("Error: " + e.getMessage());
    SampleResult.setSuccessful(false);
}
          </stringProp>
          <stringProp name="BeanShellSampler.filename"></stringProp>
          <stringProp name="BeanShellSampler.parameters"></stringProp>
          <boolProp name="BeanShellSampler.resetInterpreter">false</boolProp>
        </BeanShellSampler>
